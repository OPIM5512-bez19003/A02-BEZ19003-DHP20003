import matplotlib.pyplot as plt
import numpy as np
 
def plot_train_predictions(model, X_train_scaled, y_train, save_path="plot_train.png"):
    y_pred = model.predict(X_train_scaled)
    r2   = 1 - np.sum((y_train - y_pred)**2) / np.sum((y_train - np.mean(y_train))**2)
    rmse = np.sqrt(np.mean((y_train - y_pred)**2))
 
    fig, ax = plt.subplots(figsize=(8, 7))
    ax.scatter(y_train, y_pred, alpha=0.3, s=12, color="#2563EB", label="Samples")
    lo, hi = min(y_train.min(), y_pred.min()), max(y_train.max(), y_pred.max())
    ax.plot([lo, hi], [lo, hi], "r--", linewidth=1.5, label="Perfect fit")
    ax.set_xlabel("Actual Price (100k USD)")
    ax.set_ylabel("Predicted Price (100k USD)")
    ax.set_title(f"Actual vs. Predicted — Train Set\nR²={r2:.4f}  RMSE={rmse:.4f}")
    ax.legend()
    ax.grid(True, linestyle="--", alpha=0.4)
    plt.tight_layout()
    plt.savefig(save_path, dpi=150)
    plt.close()
    print(f"Saved: {save_path}")
 
